{
  "manifest_version": 3,
  "name": "Onshape Fast Part Renamer",
  "version": "2.0",
  "description": "Instantly rename all parts in Onshape with sequential numbering",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.onshape.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Rename Parts (Fast)"
  }
}
